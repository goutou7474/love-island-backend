{
  "name": "love-island-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:memory": "tsx src/scripts/start-memory-preview.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "bootstrap:couple": "node --env-file=.env dist/scripts/bootstrap-private-couple.js",
    "reminders:anniversaries": "node --env-file=.env --import tsx src/scripts/run-anniversary-reminders.ts",
    "reminders:anniversaries:prod": "node --env-file=.env dist/scripts/run-anniversary-reminders.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lunar-typescript": "^1.8.6",
    "pg": "^8.21.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
